<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Global packages (SourceLink, NBGV, Umbraco.Code) -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" />
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.8.118" />
    <!-- 3.0.0-beta lifts the Microsoft.CodeAnalysis cap to 5.x, required by Microsoft.EntityFrameworkCore.Design 10.x.
         Bump to 3.0.0 stable when released (build-time analyzer only, does not flow to consumers). -->
    <GlobalPackageReference Include="Umbraco.Code" Version="3.0.0-beta" />
    <GlobalPackageReference Include="Umbraco.GitVersioning.Extensions" Version="0.2.0" />
    <GlobalPackageReference Include="Umbraco.JsonSchema.Extensions" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- Umbraco CMS -->
  <!-- 18.1.0 floor: ships ContentPublishedNotification.PublishedCultures / ContentSavedNotification.SavedCultures /
       ContentUnpublishedNotification.UnpublishedCultures (umbraco/Umbraco-CMS#23313), which the content triggers consume. -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Core" Version="18.1.0" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="18.1.0" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="18.1.0" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="18.1.0" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="18.1.0" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="18.1.0" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="18.1.0" />
  </ItemGroup>
  <!-- OpenAPI (replaces Swashbuckle, which CMS v18 no longer ships transitively) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[10.0.10, 10.999.999)" />
  </ItemGroup>
  <!-- Inter-product (Umbraco.Automate) -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Automate.Core" Version="[18.3.0, 18.999.999)" />
    <PackageVersion Include="Umbraco.Automate.OpenIddict" Version="[18.1.3, 18.999.999)" />
  </ItemGroup>
  <!-- WorkflowCore (automation engine) -->
  <ItemGroup>
    <PackageVersion Include="WorkflowCore" Version="3.9.0" />
  </ItemGroup>
  <!-- CRON parsing -->
  <ItemGroup>
    <PackageVersion Include="Cronos" Version="0.9.0" />
  </ItemGroup>
  <!-- JSON Schema generation for output schemas -->
  <ItemGroup>
    <PackageVersion Include="JsonSchema.Net.Generation" Version="[5.1.1, 5.999.999)" />
  </ItemGroup>
  <!-- Jint (sandboxed JavaScript execution for the Run Script action) -->
  <ItemGroup>
    <PackageVersion Include="Jint" Version="4.11.0" />
  </ItemGroup>
  <!-- OpenIddict (Client + WebIntegration for OAuth flows) -->
  <ItemGroup>
    <PackageVersion Include="OpenIddict.Client.WebIntegration" Version="[7.6.0, 7.999.999)" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="[7.6.0, 7.999.999)" />
  </ItemGroup>
  <!-- Shared dependencies -->
  <!-- 10.0.10 floor matches the .NET runtime libraries Umbraco.Cms 18.1.0 bundles; keep in lockstep with the host CMS. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.10, 10.999.999)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="[10.0.10, 10.999.999)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="[10.0.10, 10.999.999)" />
  </ItemGroup>
  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="[10.0.7, 10.999.999)" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
