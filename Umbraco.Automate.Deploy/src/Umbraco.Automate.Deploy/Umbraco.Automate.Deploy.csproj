<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Umbraco Automate Deploy</Title>
    <Description>Umbraco Deploy support for Umbraco Automate</Description>
  </PropertyGroup>

  <!-- Use project references for local dev, NuGet packages for CI -->
  <PropertyGroup>
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\Umbraco.Automate\src\Umbraco.Automate.Core\Umbraco.Automate.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Umbraco.Automate.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Deploy.Infrastructure" />
  </ItemGroup>
</Project>
