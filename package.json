{
    "name": "umbraco-automate-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "Root package for Umbraco.Automate frontend development",
    "workspaces": [
        "Umbraco.Automate/src/Umbraco.Automate.Web.StaticAssets/Client",
        "Umbraco.Automate.OpenIddict/src/Umbraco.Automate.OpenIddict/Client"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "watch": "npm run watch --workspaces",
        "changelog": "node scripts/generate-changelog.js",
        "changelog:list": "node scripts/generate-changelog.js --list",
        "commit-options": "node scripts/list-commit-options.js",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "conventional-changelog-cli": "^5.0.0",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "prettier": "^3.8.1"
    }
}
