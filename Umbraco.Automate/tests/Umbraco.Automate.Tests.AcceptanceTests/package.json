{
  "name": "acceptancetest",
  "private": true,
  "engines": {
    "node": ">=24.13",
    "npm": ">=11"
  },
  "scripts": {
    "postinstall": "node postinstall.js",
    "config": "node config.js",
    "test": "npx playwright test DefaultConfig",
