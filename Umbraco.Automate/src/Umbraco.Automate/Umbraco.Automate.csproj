<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Umbraco Automate</Title>
        <Description>Umbraco Automate</Description>
        <PackageReadmeFile>docs\README.md</PackageReadmeFile>
        <PackageTags>umbraco automate automation umbraco-marketplace</PackageTags>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <IncludeReferencedProjects>true</IncludeReferencedProjects>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="docs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Umbraco.Automate.Startup\Umbraco.Automate.Startup.csproj" />
      <ProjectReference Include="..\Umbraco.Automate.Web.StaticAssets\Umbraco.Automate.Web.StaticAssets.csproj" />
    </ItemGroup>

    <!-- Ship buildTransitive props so consuming sites' CopyUmbracoJsonSchemaFiles target
         (from Umbraco.Cms.Targets) discovers the schema and copies it into the project. -->
    <ItemGroup>
        <Content Include="buildTransitive\**" PackagePath="buildTransitive" />
    </ItemGroup>

    <!-- Add JSON schema file to package output -->
    <PropertyGroup>
        <_UmbracoAutomateJsonSchemaReference>appsettings-schema.Umbraco.Automate.json</_UmbracoAutomateJsonSchemaReference>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="$(_UmbracoAutomateJsonSchemaReference)" PackagePath="" Visible="false" />
        <Clean Include="$(_UmbracoAutomateJsonSchemaReference)" />
    </ItemGroup>

    <!-- Generate JSON schema on build (and before copying to project) -->
    <Target Name="GenerateAppsettingsSchema" BeforeTargets="Build;CopyUmbracoJsonSchemaFiles" Inputs="$(TargetPath)" Outputs="$(_UmbracoAutomateJsonSchemaReference)">
        <Message Text="Generating $(_UmbracoAutomateJsonSchemaReference)" Importance="high" />
        <JsonSchemaGenerate AssemblyPath="$(TargetPath)" TypeName="UmbracoAutomateSchema" OutputPath="$(_UmbracoAutomateJsonSchemaReference)" IncludeObsoleteProperties="false" />
        <ItemGroup>
            <FileWrites Include="$(_UmbracoAutomateJsonSchemaReference)" />
        </ItemGroup>
    </Target>

</Project>
