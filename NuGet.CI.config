<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="LocalCI" value="./artifacts/nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- LocalCI is checked first for Umbraco.Automate packages (from current build) -->
    <packageSource key="LocalCI">
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
    <!-- Fallback to nuget.org for Umbraco.Automate packages (published releases) -->
    <!-- Umbraco.Cms and Umbraco.Cms.* resolve from nuget.org only: the more specific pattern wins over the Umbraco.*
         patterns on the MyGet feeds. MyGet's umbracoprereleases can carry a different package under the
         same version (e.g. Umbraco.Cms.Search.Core 19.0.0-beta1), so allowing both made restore depend on
         which feed answered first. -->
    <packageSource key="nuget.org">
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
      <package pattern="Umbraco.Cms" />
      <package pattern="Umbraco.Cms.*" />
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
      <package pattern="*" />
    </packageSource>
    <!-- Fallback to nightly for Umbraco packages (prereleases) -->
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
    <packageSource key="Umbraco Prereleases">
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
